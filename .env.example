# Copy to .env for local dev. Every variable is documented in src/lib/server/config.ts.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=framed
POSTGRES_USER=framed
POSTGRES_PASSWORD=

ORIGIN=http://localhost:5175
# FRAMED_ALLOWED_HOSTS=framed.example.com
# Behind a reverse proxy: the header carrying the client IP (sign-in rate limit).
# ADDRESS_HEADER=X-Real-IP
FRAMED_ADMIN_EMAILS=you@example.com

SMTP_HOST=localhost
SMTP_PORT=25
# EMAIL_FROM=Framed <framed@example.com>

FRAMED_MOVIES_DIR=/path/to/Movies
FRAMED_FRAMES_DIR=./data/frames
FRAMED_INGEST_CONCURRENCY=1
FRAMED_SCAN_MINUTES=60
# FRAMED_INGEST=off
# FRAMED_EMAIL=off

# Optional: v3 API key or v4 read access token from https://www.themoviedb.org/settings/api
TMDB_API_KEY=
